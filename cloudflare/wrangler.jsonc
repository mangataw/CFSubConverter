{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sub-store-cloudflare",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "secrets": {
    "required": [
      "SUB_STORE_ADMIN_TOKEN",
      "SUB_STORE_PUBLIC_DOWNLOAD_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sub-store-cloudflare",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ASSET_SNAPSHOTS"
    }
  ],
  "vars": {
    "SUB_STORE_APP_NAME": "Sub-Store Cloudflare",
    "SUB_STORE_PUBLIC_DOWNLOAD_HOSTS": "",
    "REMOTE_TEMPLATE_ID": "github-mihomo",
    "REMOTE_TEMPLATE_URL": "https://raw.githubusercontent.com/mangataw/LadderTools/main/configs/mihomo-template.yaml",
    "REMOTE_TEMPLATE_ALLOWED_HOSTS": "raw.githubusercontent.com",
    "REMOTE_ASSET_CACHE_SECONDS": "300",
    "ALLOW_TEMPORARY_SOURCE_OVERRIDE": "false"
  }
}
